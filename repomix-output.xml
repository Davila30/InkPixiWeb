}

.form-panel {
  display: grid;
  place-items: center;
  padding: 56px clamp(28px, 7vw, 82px);
  background: #fff;
}

.form-content {
  width: min(100%, 360px);
}

.form-content h2 {
  margin: 9px 0 8px;
