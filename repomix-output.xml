}

form {
  display: flex;
  flex-direction: column;
}

label {
  margin: 0 0 8px;
  color: #55485d;
  font-size: 12px;
  font-weight: 700;
}

input {
  width: 100%;
  height: 46px;
  margin-bottom: 20px;
  padding: 0 14px;
  border: 1px solid #e8e1eb;
  border-radius: 9px;
  outline: none;
  background: #fcfafc;
  color: #423649;
  font: inherit;
  font-size: 13px;
  transition:
    border-color 160ms ease,
    box-shadow 160ms ease;
}

input::placeholder {
  color: #b2aab5;
}

input:focus {
  border-color: #9c72bd;
  box-shadow: 0 0 0 3px #9c72bd20;
}

input[aria-invalid='true'] {
  border-color: #c65e78;
}

.field-error {
  margin: -14px 0 14px;
  color: #ae405c;
  font-size: 11px;
}

.submit-button {
  min-height: 46px;
  margin-top: 6px;
  border: 0;
  border-radius: 24px;
  background: #8052b2;
  color: #fff;
