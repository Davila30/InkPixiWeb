<file path="src/app/shared/components/art-card/art-card.css">
:host {
  display: block;
  min-width: 0;
}

.art-card {
  position: relative;
  display: flex;
  height: 100%;
  flex-direction: column;
  padding: 18px;
  overflow: hidden;
  border-radius: 20px;
  background: var(--bg-card, #eee5f4);
  color: var(--text-main, #382d42);
}

.guardar {
  position: absolute;
  z-index: 1;
  top: 12px;
  right: 12px;
  display: grid;
  width: 34px;
  height: 34px;
  place-items: center;
  border: 0;
  border-radius: 50%;
  background: rgba(238, 229, 244, 0.9);
  color: var(--text-main, #392b45);
  cursor: pointer;
}

.guardar svg {
  width: 18px;
  height: 18px;
  fill: none;
  stroke: currentColor;
  stroke-linecap: round;
  stroke-linejoin: round;
  stroke-width: 1.8;
}

.guardar.saved svg,
.likes.liked svg {
  fill: currentColor;
}

.guardar:focus-visible,
.likes:focus-visible,
.ver-portfolio:focus-visible {
  outline: 2px solid var(--color-primary, #76509a);
  outline-offset: 3px;
}

.card-img {
  display: flex;
  width: 82%;
  aspect-ratio: 3 / 4;
  align-items: center;
  justify-content: center;
  align-self: center;
  overflow: hidden;
  border: 7px solid #514951;
  background: #b7a5c5;
}

.card-img.sin-imagen {
  background:
    radial-gradient(ellipse at 50% 58%, #e8c447 0 7%, transparent 7.5%),
    radial-gradient(ellipse at 50% 57%, #354b46 0 23%, transparent 23.5%),
    linear-gradient(160deg, transparent 0 28%, #574b82 28% 42%, #386b91 42% 59%, #b8a78d 59% 100%);
  box-shadow: inset 0 0 0 2px rgba(255, 255, 255, 0.28);
}

.card-img img {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.titulo {
  overflow: hidden;
  margin: 16px 2px 0;
  color: var(--text-main, #382d42);
  font-size: 16px;
  font-weight: 700;
  line-height: 1.35;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.autor,
.categoria {
  overflow: hidden;
  margin: 5px 2px 0;
  color: var(--text-muted, #81768a);
