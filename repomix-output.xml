.featured-art::after {
  position: absolute;
  content: "";
}

.featured-art::before {
  top: 16%;
  left: 36%;
  width: 28%;
  height: 75%;
  border-radius: 50% 50% 30% 30%;
  background: linear-gradient(90deg, rgba(0, 0, 0, 0.16), rgba(255, 255, 255, 0.22), rgba(0, 0, 0, 0.18));
}

.featured-art::after {
  inset: auto 0 0;
  height: 24%;
  background: linear-gradient(transparent, rgba(28, 22, 32, 0.25));
}

.art-portrait {
  background:
    radial-gradient(ellipse at 52% 42%, #c4bcb5 0 13%, transparent 14%),
    linear-gradient(130deg, #ece9e6, #a9a5a2 60%, #d7d2ce);
  filter: grayscale(1);
}

.art-forest {
  background:
    radial-gradient(ellipse at 50% 90%, #f6c673 0 4%, transparent 5%),
    linear-gradient(180deg, #574ba2, #eb8cb8 52%, #183c48);
}

.art-forest::before {
  top: 32%;
  width: 100%;
  height: 70%;
  border-radius: 55% 55% 0 0;
  background: repeating-linear-gradient(90deg, #142d3e 0 8%, transparent 8% 18%);
}

.art-sketch {
  background: repeating-linear-gradient(125deg, #eee7dc 0 8px, #d6cec2 9px 10px);
}

.art-sketch::before {
  border: 2px solid #423a35;
  background: transparent;
  transform: rotate(-12deg);
}

.art-figure {
  background: linear-gradient(115deg, #d3d0ca, #aaa7a2);
  filter: grayscale(1);
}

.art-figure::before {
  left: 42%;
  width: 18%;
  background: linear-gradient(#706a65 0 24%, transparent 25% 35%, #706a65 36% 100%);
}

.art-dark {
  background: radial-gradient(ellipse at center, #645875, #191720 72%);
}

.art-dark::before {
  background: linear-gradient(90deg, #211d28, #a49bad 48%, #211d28);
  box-shadow: 20px 12px 0 -7px #17151d, -22px 18px 0 -8px #17151d;
}

.art-creature {
  background:
    radial-gradient(circle at 66% 38%, #f8f6f1 0 3%, transparent 3.5%),
    radial-gradient(circle at 52% 40%, #f8f6f1 0 3%, transparent 3.5%),
    linear-gradient(135deg, #eeeae2, #b9c1bf);
  filter: grayscale(0.65);
}

.art-creature::before {
  left: 25%;
  width: 50%;
  border-radius: 48% 48% 40% 40%;
  background: #f7f6f2;
  box-shadow: inset 0 0 0 2px #8d9290;
}

.featured-work h4 {
  overflow: hidden;
  margin: 6px 6px 3px;
  font-size: 10px;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.work-meta {
  display: flex;
  justify-content: space-between;
  gap: 4px;
  padding: 0 6px 7px;
  color: #8d8296;
  font-size: 8px;
}

.work-meta span {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.work-meta span:first-child,
.view-all {
  color: #8051bc;
}

.view-all {
  display: inline-block;
  margin-top: 12px;
  font-size: 10px;
  text-decoration: none;
}

.nav-links a:focus-visible,
.user-info:focus-visible,
.logo:focus-visible,
.contact-button:focus-visible,
.view-all:focus-visible {
  outline: 2px solid #76509a;
  outline-offset: 3px;
}

@media (max-width: 600px) {
  .navbar {
    grid-template-columns: 1fr auto;
    padding: 6px 14px;
  }

  .nav-links {
    grid-row: 2;
    grid-column: 1 / -1;
    justify-content: center;
  }

  .profile-content {
    padding: 12px;
  }

  .artist-profile {
    padding: 10px;
    border-radius: 20px;
  }

  .cover-art {
    height: 125px;
  }

  .artist-info {
    min-height: 0;
    flex-wrap: wrap;
    gap: 10px;
    padding: 76px 8px 8px;
  }

  .artist-avatar {
    bottom: auto;
    top: 68px;
    left: 20px;
    width: 100px;
  }

  .artist-copy {
    flex-basis: 100%;
    padding-left: 108px;
  }

  .artist-copy h1 {
    font-size: 17px;
  }

  .artist-copy p {
    font-size: 12px;
  }

  .contact-button {
    width: 100%;
    min-height: 36px;
  }

  .featured-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

@media (max-width: 360px) {
  .featured-grid {
    grid-template-columns: 1fr;
  }
}
